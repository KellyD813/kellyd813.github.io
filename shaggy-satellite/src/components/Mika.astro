---
const mikaPhotos = [
  { src: "./src/assets/mika-ball.jpg", alt: "Mika with a ball" },
  { src: "./src/assets/mika-computer.jpg", alt: "Mika at the computer" },
  { src: "./src/assets/mika-jacket.jpg", alt: "Mika in a jacket" },
];
---

<h1>Mika</h1>
<section>
  <ul>
    {
      mikaPhotos.map(({ src, alt }) => (
        <li><img src={src} alt={alt} /></li>
      ))
    }
  </ul>
</section>

<style>
  img {
    max-height: 400px;
    width: auto;
  }
</style>