---
const year = new Date().getFullYear();
const mikaPhotos = "XXXXX"; // TODO
const links = [
  { href: "https://github.com/KellyD813", label: "GitHub" },
  { href: "https://www.linkedin.com/in/kellydevine-dev", label: "LinkedIn" },
];
---

<footer class="site-footer">
  <p>© {year} Kelly Devine. Built with a Red Bull, <a href={mikaPhotos} target="_blank" rel="noopener noreferrer">Mika</a> by my side, and way too many browser tabs.</p>
  <ul>
    {
      links.map(({ href, label }) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 1.5rem;
    margin-top: 3rem;
    font-size: 0.9rem;
  }

  p {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: inherit;
  }
</style>